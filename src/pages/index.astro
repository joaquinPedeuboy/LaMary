---
	import MainLayout from '@/layouts/MainLayout.astro'
	import { Picture } from "astro:assets";
	import CategoryIconLabel from '@/components/ui/CategoryIconLabel.astro'
	import bg from '@/assets/camion3.jpeg'
	import chasis from '@/assets/chasis.jpeg'
	import jauladoble from '@/assets/JaulaDoble3.jpeg'
	import jaulaSimple from '@/assets/JaulaSimple4.jpeg'
	import iconEficia from '@/assets/elementosGraficos/Sin título-3-10.png'
	import iconLegado from '@/assets/elementosGraficos/Sin título-3-09.png'
	import iconCamino from '@/assets/elementosGraficos/Sin título-3-06.png'
	import elementGraphics from '@/assets/elementosGraficos/Sin título-3-01.png'
	import elementGraphics2 from '@/assets/elementosGraficos/Sin título-3-02.png'
	import esencia from '@/assets/elementosGraficos/Sin título-3-03.png'
	import personalidad from '@/assets/elementosGraficos/Sin título-3-01.png'
	import valores from '@/assets/elementosGraficos/Sin título-3-04.png'
	import proposito from '@/assets/elementosGraficos/Sin título-3-02.png'
	import HomeContact from '@/components/contact/HomeContact.astro';
---
<MainLayout
	title='Inicio'
	subtitle="Más que transporte, un legado.|Tres generaciones,|el mismo compromiso."
	bgImage={bg.src}
>
<!-- Sobre nosotros -->
	<h2 class="text-marron-tierra text-center font-display font-bold text-lg md:text-2xl uppercase after:laMary-icon">
		Conoce más
		<span class="block text-2xl md:text-5xl text-marron-tierra font-display font-black">Sobre Nosotros</span>
	</h2>
	<div class="w-1/4 h-1 bg-marron-tierra mx-auto mt-2 rounded"></div>

	<p class="text-center text-xl mt-8 font-sans max-w-4xl mx-auto">
		La Mary es más que una empresa de gestión de transporte: es el reflejo de un legado que sigue creciendo con compromiso, respeto y confianza. Una marca que mira hacia adelante, sin olvidar de dónde viene.
	</p>

	<div class="relative mt-20">

		<!-- Línea tipo ruta -->
		<div class="hidden lg:block absolute top-1/2 left-1/2 -translate-x-1/2 w-[90%] h-1">
			<div class="w-full h-full border-t-4 border-dashed border-marron-tierra/60"></div>
		</div>


		<div class="relative grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
			<CategoryIconLabel 
				icon={iconEficia}
				text="Eficacia, confianza y profesionalidad"
			/>

			<CategoryIconLabel 
				icon={iconLegado}
				text="Más que transporte, un legado"
			/>

			<CategoryIconLabel 
				icon={iconCamino}
				text="De generación en generación, marcando camino"
			/>
		</div>

	</div>
<!-- Servicios -->
	<section slot="after-main-content" class="bg-marron-tierra w-full py-24 relative overflow-hidden">
		<!-- Imagenes de fondo -->
		<div class="max-w-7xl mx-auto px-6 relative">

			<!-- IZQUIERDA -->
			<Picture
			src={elementGraphics}
			alt="elementGraphics"
			class="absolute -left-60 top-0 w-65 opacity-10 pointer-events-none"
			/>

			<Picture
			src={elementGraphics2}
			alt="elementGraphics"
			class="absolute -left-60 bottom-10 w-65 opacity-10 pointer-events-none"
			/>

			<!-- DERECHA -->
			<Picture
			src={elementGraphics}
			alt="elementGraphics"
			class="absolute -right-60 top-0 w-65 opacity-10 pointer-events-none"
			/>

			<Picture
			src={elementGraphics2}
			alt="elementGraphics"
			class="absolute -right-60 bottom-10 w-65 opacity-10 pointer-events-none"
			/>

			<!-- Contenido -->
			<div class="relative z-10 flex flex-col items-center text-center">

				<h2 class="font-display text-white text-2xl uppercase">
					Nuestros
					<span class="block text-5xl font-black mt-2">Servicios</span>
				</h2>

				<div class="w-20 h-1 bg-crema-natural mt-4 rounded"></div>

				<!-- Cards -->
				<div class="grid grid-cols-1 md:grid-cols-3 gap-10 w-full mt-10">
					<div
						class="bg-crema-natural rounded-2xl shadow-2xl overflow-hidden
							w-full
							reveal-card"
					>
						<div class="w-full h-72 md:h-80 overflow-hidden">
							<Picture
								src={chasis}
								alt="Camión de transporte"
								formats={['avif', 'webp']}
								class="w-full h-full object-cover"
							/>
						</div>

						<div class="p-8">
							<h3 class="text-2xl font-display font-semibold text-azul-marino">
								Chasis
							</h3>
						</div>
					</div>
					<div
						class="bg-crema-natural rounded-2xl shadow-2xl overflow-hidden
							w-full
							reveal-card"
					>
						<div class="w-full h-72 md:h-80 overflow-hidden">
							<Picture
								src={jauladoble}
								alt="Camión de transporte"
								formats={['avif', 'webp']}
								class="w-full h-full object-cover"
							/>
						</div>

						<div class="p-8">
							<h3 class="text-2xl font-display font-semibold text-azul-marino">
								Jaula Doble
							</h3>
						</div>
					</div>
					<div
						class="bg-crema-natural rounded-2xl shadow-2xl overflow-hidden
							w-full
							reveal-card"
					>
						<div class="w-full h-72 md:h-80 overflow-hidden">
							<Picture
								src={jaulaSimple}
								alt="Camión de transporte"
								formats={['avif', 'webp']}
								class="w-full h-full object-cover"
							/>
						</div>

						<div class="p-8">
							<h3 class="text-2xl font-display font-semibold text-azul-marino">
								Jaula Simple
							</h3>
						</div>
					</div>
				</div>
				
			</div>
		</div>
	</section>
<!-- Por que elegirnos -->
	<section slot="after-main-content" class="bg-crema-natural w-full py-24">
		<div class="max-w-7xl mx-auto px-6">
			<div class="flex flex-col items-center text-center">
				<h3 class="font-display font-bold text-azul-marino text-2xl">¿Por qué elegirnos?</h3>
				<div class="w-30 h-1 bg-marron-tierra mt-4 rounded"></div>
			</div>

			<!-- Íconos -->
			<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-10 mt-6 reveal-card">

				<!-- Item -->
				<div class="flex flex-col items-center text-center transition-transform duration-300 hover:-translate-y-2">
					<Picture
					src={esencia}
					alt="Esencia"
					class="w-20 h-20 mb-2"
					formats={['avif', 'webp']}
					/>
					<h4 class="font-sans text-xl font-bold text-azul-marino">
					Identidad
					</h4>
					<p class="mt-3 text-marron-tierra text-base max-w-xs">
					Honestidad, trabajo y constancia. La Mary es la fuerza de lo que se construye con valores, manteniendo siempre la palabra y la responsabilidad.
					</p>
				</div>

				<!-- Item -->
				<div class="flex flex-col items-center text-center transition-transform duration-300 hover:-translate-y-2">
					<Picture
					src={personalidad}
					alt="Personalidad"
					class="w-20 h-20 mb-2"
					formats={['avif', 'webp']}
					/>
					<h4 class="font-sans text-xl font-bold text-azul-marino">
					Personalidad
					</h4>
					<p class="mt-3 text-marron-tierra text-base max-w-xs">
					Cercana, profesional y confiable. Una marca que combina la calidez de lo familiar con la seriedad de un servicio eficiente.
					</p>
				</div>

				<!-- Item -->
				<div class="flex flex-col items-center text-center transition-transform duration-300 hover:-translate-y-2">
					<Picture
						src={valores}
						alt="Valores"
						class="w-20 h-20 mb-2"
						formats={['avif', 'webp']}
					/>
					<h4 class="font-sans text-xl font-bold text-azul-marino">
					Valores
					</h4>
					<p class="mt-3 text-marron-tierra text-base max-w-xs">
					Esfuerzo, compromiso, respeto, transparencia y responsabilidad.
					</p>
				</div>

				<!-- Item -->
				<div class="flex flex-col items-center text-center transition-transform duration-300 hover:-translate-y-2">
					<Picture
						src={proposito}
						alt="Propósito"
						class="w-20 h-20 mb-2"
						formats={['avif', 'webp']}
					/>
					<h4 class="font-sans text-xl font-bold text-azul-marino">
					Propósito
					</h4>
					<p class="mt-3 text-marron-tierra text-base max-w-xs">
					Brindar un servicio de gestión de hacienda eficiente, transparente y confiable, priorizando la satisfacción del cliente y la construcción de vínculos duraderos.
					</p>
				</div>
			</div>
		</div>
	</section>
	<!-- Contacto -->
	<HomeContact slot='after-main-content'/>

</MainLayout>
