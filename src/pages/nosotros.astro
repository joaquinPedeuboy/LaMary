---
    import { Picture } from "astro:assets";
    import MainLayout from "../layouts/MainLayout.astro";
    import { NosotrosSchema } from '@/types'
    import HomeContact from "@/components/contact/HomeContact.astro";

    const url = `${import.meta.env.API_URL}/pages?slug=nosotros`
    const res = await fetch(url, {
        cache: 'no-store'
    })
    const json = await res.json()
    const data = NosotrosSchema.parse(json[0])

---

<MainLayout
    title={data.title.rendered}
    pageTitle={data.title.rendered}
    subtitle={data.acf.subtitle}
    bgImage={data.featured_images.full.url}
>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 text-center items-center">
        <Picture
            src={data.featured_images.large.url}
            alt={`Imagen de ${data.title.rendered}`}
            width={data.featured_images.large.width}
            height={data.featured_images.large.height}
            formats={['avif', 'webp']}
            class="shadow-lg transform -rotate-10 border-10 border-white"
        />
        <div class="text-xl space-y-3 mt-10 md:mt-0 font-sans text-gray-500 leading-relaxed" set:html={data.content.rendered}></div>
        
    </div>
<!-- Linea de tiempo -->
    <section class="bg-white py-24 mt-30">
		<div class="max-w-6xl mx-auto px-6">

			<h2 class="text-center font-display text-marron-tierra text-xl md:text-2xl uppercase">
				Nuestra
				<span class="block text-3xl md:text-5xl font-black mt-2">Historia</span>
			</h2>

			<div class="w-24 h-1 bg-marron-tierra mx-auto mt-4 rounded"></div>

			<p class="text-center text-xl mt-8 max-w-3xl mx-auto">
				Tres generaciones recorriendo caminos y construyendo confianza.
			</p>

			<div class="relative mt-20">

				<div class="absolute left-6 lg:left-1/2 lg:-translate-x-1/2 h-full w-1 bg-marron-tierra/30"></div>

				<div class="space-y-20">

					<div class="reveal-card flex items-start gap-6 lg:gap-0 lg:flex-row">

                        <!-- Punto -->
                        <div class="mt-1 w-10 h-10 rounded-full bg-marron-tierra border-4 border-white shadow-lg z-10 shrink-0 lg:absolute lg:left-1/2 lg:-translate-x-1/2"></div>

                        <!-- Contenido -->
                        <div class="lg:w-1/2 lg:pr-12 lg:text-right">
                            <h3 class="text-2xl font-semibold text-azul-marino">
                            Primera generación
                            </h3>
                            <p class="mt-3 text-lg">
                            Los primeros kilómetros, el trabajo a pulmón y el compromiso
                            con cada productor.
                            </p>
                        </div>

                        <!-- Espacio desktop -->
                        <div class="hidden lg:block lg:w-1/2"></div>
                    </div>


					<div class="reveal-card flex items-start gap-6 lg:gap-0 lg:flex-row">

                        <div class="hidden lg:block lg:w-1/2"></div>

                        <div class="mt-1 w-10 h-10 rounded-full bg-gris border-4 border-white shadow-lg z-10 shrink-0 lg:absolute lg:left-1/2 lg:-translate-x-1/2"></div>

                        <div class="lg:w-1/2 lg:pl-12">
                            <h3 class="text-2xl font-semibold text-azul-marino">
                            Segunda generación
                            </h3>
                            <p class="mt-3 text-lg">
                            Crecimiento, profesionalización y más rutas recorridas
                            sin perder los valores.
                            </p>
                        </div>
                    </div>

					<div class="reveal-card flex items-start gap-6 lg:gap-0 lg:flex-row">

                        <div class="mt-1 w-10 h-10 rounded-full bg-azul-marino border-4 border-white shadow-lg z-10 shrink-0 lg:absolute lg:left-1/2 lg:-translate-x-1/2"></div>

                        <div class="lg:w-1/2 lg:pr-12 lg:text-right">
                            <h3 class="text-2xl font-semibold text-azul-marino">
                            Tercera generación
                            </h3>
                            <p class="mt-3 text-lg">
                            Una empresa moderna, con la misma esencia:
                            confianza, respeto y legado.
                            </p>
                        </div>

                        <div class="hidden lg:block lg:w-1/2"></div>
                    </div>

				</div>
			</div>

		</div>
	</section>
    <HomeContact slot='after-main-content'/>

</MainLayout>