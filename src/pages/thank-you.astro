---
    import { Picture } from "astro:assets"
	import elementGraphics from '@/assets/elementosGraficos/Sin título-3-01.png'
	import elementGraphics2 from '@/assets/elementosGraficos/Sin título-3-02.png'
	import elementGraphics3 from '@/assets/sinFondo/NEGRO - 2 (2).png'
	import elementGraphics4 from '@/assets/sinFondo/NEGRO - 1.png'
    import "../styles/global.css"
---

<main class="min-h-screen flex items-center justify-center bg-crema-natural px-6 relative">
    <!-- IZQUIERDA -->
    <div class="hidden lg:flex absolute left-20 top-20 w-65 opacity-10 pointer-events-none">
        <Picture src={elementGraphics} alt="elementGraphics" />
    </div>

    <div class="hidden lg:flex absolute left-20 bottom-90 w-65 opacity-10 pointer-events-none">
        <Picture src={elementGraphics4} alt="elementGraphics" />
    </div>

    <div class="hidden lg:flex absolute left-20 bottom-10 w-65 opacity-10 pointer-events-none">
        <Picture src={elementGraphics2} alt="elementGraphics" />
    </div>

    <!-- DERECHA -->
    <div class="hidden lg:flex absolute right-20 top-20 w-65 opacity-10 pointer-events-none">
        <Picture src={elementGraphics} alt="elementGraphics" />
    </div>

    <div class="hidden lg:flex absolute right-20 bottom-90 w-65 opacity-10 pointer-events-none">
        <Picture src={elementGraphics3} alt="elementGraphics" />
    </div>

    <div class="hidden lg:flex absolute right-20 bottom-10 w-65 opacity-10 pointer-events-none">
        <Picture src={elementGraphics2} alt="elementGraphics" />
    </div>

    <div
        class="
        text-center
        max-w-3xl
        w-full
        p-6 sm:p-10
        bg-white
        shadow-2xl
        rounded-2xl
        relative
        overflow-hidden
        "
    >
        <!-- Decoración superior -->
        <div class="absolute inset-x-0 top-0 h-1 bg-marron-tierra"></div>

        <!-- Ícono -->
        <div class="w-20 h-20 mx-auto mb-6 rounded-full bg-marron-tierra/10 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round"
                class="text-marron-tierra">
                <path d="M5 13l4 4L19 7" />
            </svg>
        </div>

        <!-- Título -->
        <h1 class="text-4xl font-display text-marron-tierra font-black mb-4">
            Gracias!
        </h1>

        <!-- Mensaje -->
        <p class="text-lg sm:text-xl text-gray-700 leading-relaxed">
            Tu mensaje fue enviado correctamente.<br />
            En breve nos comunicamos.
        </p>

        <!-- CTA -->
        <a
            href="/"
            class="
            inline-flex
            items-center
            justify-center
            gap-2
            mt-8
            px-6 sm:px-8
            py-3
            w-full sm:w-auto
            bg-marron-tierra
            text-white
            rounded-full
            font-bold
            transition
            hover:scale-105
            hover:shadow-lg
            active:scale-95
            "
        >
            Volver al inicio
        </a>
    </div>
</main>
<script is:inline>
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
        event: 'thank_you_view'
    });
</script>