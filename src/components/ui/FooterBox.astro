---
    interface Props {
        heading: string
    }

    const { heading } = Astro.props
---

<div class="flex flex-col items-center text-center space-y-3 mt-2 md:mt-0">
    <h3 class="text-crema-natural font-display  text-sm md:text-2xl font-bold uppercase">{heading}</h3>
    <div class="items-start space-y-6 text-white mt-4 md:mt-10">
        <slot />
    </div>
</div>