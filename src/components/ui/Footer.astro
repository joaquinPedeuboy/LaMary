---
    import { Picture } from "astro:assets";
    import FooterBox from "./FooterBox.astro";
    import imageFooter from "@/assets/sinFondo/NEGRO - 1(1).png"
    import { NosotrosSchema } from '@/types'

    const url = `${import.meta.env.API_URL}/pages?slug=nosotros`
    const res = await fetch(url, {
        cache: 'no-store'
    })
    const json = await res.json()

    const dataequipo = NosotrosSchema.parse(json[0])

---

<footer class="bg-azul-oscuro border-t border-white/10 p-10 md:pt-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 lg:gap-10">
        <div class="max-w-4xl mx-auto flex flex-col items-center text-center gap-6">
            <Picture src={imageFooter} alt="isotipo" formats={['avif', 'webp']} class="w-36 md:w-80"/>
            <FooterBox
                heading="Tres generaciones. El mismo compromiso"
            />
            
        </div>
        <div class="md:hidden w-16 h-0.5 bg-marron-tierra mx-auto my-6 rounded"></div>
        <FooterBox heading="Nuestras Redes">

            <a 
                id="btn-email"
                href="mailto:lamary@transportelamary.com?subject=Consulta%20desde%20la%20web&body=Hola,%20te%20contacto%20desde%20la%20web%20de%20La%20Mary" 
                class="group flex items-center gap-3 hover:text-gray-500 active:text-gray-500 transition duration-300"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-mail w-5 h-5 shrink-0 transition-transform duration-300 group-hover:scale-110"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10" /><path d="M3 7l9 6l9 -6" /></svg>
                <p class="font-sans font-medium text-lg">lamary@transportelamary.com</p>
            </a>

            <a 
                id="btn-social-facebook"
                href="https://www.facebook.com/profile.php?id=61580660799739" 
                class="group flex items-center gap-3 hover:text-gray-500 active:text-gray-500 transition duration-300"
                target="_blank" 
                rel="noopener noreferrer"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-brand-facebook w-5 h-5 shrink-0 transition-transform duration-300 group-hover:scale-110"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3" /></svg>
                <p class="font-sans font-medium text-lg">Transporte La Mary</p>
            </a>

            <a 
                id="btn-social-instagram"
                href="https://www.instagram.com/transportelamary/" 
                class="group flex items-center gap-3 hover:text-gray-500 active:text-gray-500 transition duration-300"
                target="_blank" 
                rel="noopener noreferrer"
                aria-label="Instagram Transporte La Mary"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-brand-instagram w-5 h-5 shrink-0 transition-transform duration-300 group-hover:scale-110"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4l0 -8" /><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" /><path d="M16.5 7.5v.01" /></svg>
                <p class="font-sans font-medium">@transporteLaMary</p>
            </a>

            <a 
                id="btn-phone"
                href={`tel:${dataequipo.acf.worker_1_whatsapp}`}
                class="group flex items-center gap-3 hover:text-gray-500 active:text-gray-500 transition duration-300"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-device-mobile w-5 h-5 shrink-0 transition-transform duration-300 group-hover:scale-110"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M6 5a2 2 0 0 1 2 -2h8a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2h-8a2 2 0 0 1 -2 -2v-14" /><path d="M11 4h2" /><path d="M12 17v.01" /></svg>
                <p class="font-sans font-medium text-lg">{dataequipo.acf.worker_1_whatsapp}</p>
            </a>

            <a
                id="btn-wpp-footer"
                onclick="window.dataLayer && dataLayer.push({ event: 'click_whatsapp', position: 'header' })"
                href={`https://wa.me/${dataequipo.acf.worker_1_whatsapp}?text=${encodeURIComponent(
                `Hola, te contacto desde la web de La Mary`
                )}`}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-3 hover:text-gray-500 active:text-gray-500 transition duration-300"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-brand-whatsapp w-5 h-5 shrink-0 transition-transform duration-300 group-hover:scale-110"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" /><path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" /></svg>
                <p class="font-sans font-medium text-lg">{dataequipo.acf.worker_1_whatsapp}</p>
            </a>
            

        </FooterBox>
    </div>

    <p class="py-10 text-center text-crema-natural text-sm opacity-70">
        Todos los derechos reservados. La Mary. &copy; {new Date().getFullYear() }
    </p>
    <p class="text-center text-xs text-crema-natural opacity-50">
        Diseñado y desarrollado por 
        <a 
            href="https://github.com/joaquinPedeuboy" 
            target="_blank" 
            rel="noopener noreferrer"
            class="underline underline-offset-2 hover:opacity-80 transition"
        >
            Joaquín Pedeuboy · Desarrollador Web
        </a>
    </p>
</footer>