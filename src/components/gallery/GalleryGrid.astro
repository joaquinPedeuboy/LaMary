---
    import type { Gallery } from '@/types'
    import { Picture } from 'astro:assets'
    interface Props {
        gallery: Gallery[]
    }
    const { gallery } = Astro.props
---

<div id="gallery" class="grid grid-cols-1 md:grid-cols-3 gap-5">
    {gallery.map(image => (
        <div class="relative w-full h-56 md:h-64 lg:h-72 rounded-xl overflow-hidden bg-white shadow-lg border-8 border-white transition-transform duration-300 hover:scale-[1.02]">
            <a 
                href={image.full.url}
                data-pswp-width={image.full.width}
                data-pswp-height={image.full.height}
            >
                <Picture
                src={image.large.url}
                alt='Galeria de imágenes'
                width={image.large.width}
                height={image.large.height}
                formats={['avif', 'webp']}
                class="w-full h-full object-cover reveal-card"
                />
            </a>
        </div>
    ))}
</div>

<script>
    import PhotoSwipeLightbox from "photoswipe/lightbox";
    import 'photoswipe/style.css'

    const lightbox = new PhotoSwipeLightbox({
        gallery: '#gallery',
        children: 'a',
        pswpModule: ()=> import('photoswipe')
    })
    lightbox.init()
    document.addEventListener('astro:after-swap', function() {
        lightbox.init()
    })
</script>