<section class="bg-white px-6 md:px-20 py-16 md:pb-40 mx-auto">
    <div class="reveal-card max-w-6xl mx-auto">

        <h2 class="font-display text-azul-marino text-center font-black text-sm md:text-lg uppercase">
        Coordiná tu translado con nosotros
        <span
            class="
            font-display font-bold text-azul-oscuro
            text-lg min-[321px]:text-xl sm:text-2xl md:text-3xl
            block mt-2 h1-mask delay
            "
        >
            Solicitá tu cotización
        </span>
        </h2>

        <div
        class="
            grid
            grid-cols-1
            md:grid-cols-2
            gap-8 md:gap-12
            mt-12
        "
        >
            <!-- Formulario -->
            <div class="order-1 md:order-0">
                <ContactForm />
                <div class="md:hidden w-1/4 h-1 bg-marron-tierra mx-auto mt-10 rounded"></div>
            </div>
            
            <!-- Mapa -->
            <div
                class="
                order-2
                md:order-0
                h-70 sm:h-87.5 md:h-auto
                rounded-xl
                overflow-hidden
                shadow-lg
                md:shadow-none
                md:rounded-none
                "
            >
                <LocationMap location={data.acf.location} />
            </div>
        </div>

    </div>
</section>
